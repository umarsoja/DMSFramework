[Unit]
Description=APGC DMS Django application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dmsapp
Group=www-data
WorkingDirectory=/opt/apgc-dms/app/backend
EnvironmentFile=/etc/apgc-dms/apgc-dms.env
RuntimeDirectory=apgc-dms
RuntimeDirectoryMode=0750
ExecStart=/opt/apgc-dms/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/apgc-dms/gunicorn.sock --umask 007 --error-logfile -
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/apgc-dms/private-media

[Install]
WantedBy=multi-user.target
