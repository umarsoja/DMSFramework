# Copy to /etc/apgc-dms/apgc-dms.env on the Droplet and restrict it to root
# only (root:root, mode 0600). This file is a template; add no real values here.
# No production hostname has been confirmed. Keep hostname fields blank until
# the owner approves the DNS name and HTTPS origin.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DMS_BASE_URL=
DATABASE_URL=postgresql://apgc_dms_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/apgcdms
PRIVATE_MEDIA_ROOT=/var/lib/apgc-dms/private-media

# This Nginx example terminates TLS and overwrites X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Use the company's approved Zoho account and store the password as a secret.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtppro.zoho.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20

# Select exactly one delivery provider. Zoho API uses HTTPS and OAuth tokens.
EMAIL_DELIVERY_PROVIDER=smtp
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_AUTH_URL=https://accounts.zoho.com/oauth/v2/auth
ZOHO_OAUTH_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_OAUTH_REDIRECT_URI=https://dms.alliance-erp.com/integrations/zoho/callback/
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com/api
ZOHO_MAIL_ACCOUNT_ID=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZOHO_MAIL_TOKEN_ENCRYPTION_KEY=
